# copy this file to .env and fill in the passwords
# (the MySQL passwords are the ones in database/00_setup_root.sql)
# put passwords in quotes, because # starts a comment if there are no quotes
PORT=3000
SESSION_SECRET=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=toocute_bookstore

# the web app never uses root
DB_CUSTOMER_USER=app_customer
DB_CUSTOMER_PASS=""
DB_STAFF_USER=app_staff
DB_STAFF_PASS=""

# login for the staff pages on the website
STAFF_USERNAME=staff
STAFF_PASSWORD=""
